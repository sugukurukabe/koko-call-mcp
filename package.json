{
  "name": "jp-bids-mcp",
  "version": "0.10.1",
  "description": "日本の官公需公告をMCPで検索・順位付け・要件抽出・出力する（完全無料・読み取り中心・7ツール）。Search, rank, extract requirements, and export Japanese public procurement notices through MCP (free, read-centric, 7 tools).",
  "type": "module",
  "license": "Apache-2.0",
  "mcpName": "io.github.sugukurukabe/jp-bids",
  "main": "./dist/mcp.js",
  "types": "./dist/mcp.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./api": {
      "types": "./dist/api/kkj-client.d.ts",
      "import": "./dist/api/kkj-client.js"
    },
    "./types": {
      "types": "./dist/domain/bid.d.ts",
      "import": "./dist/domain/bid.js"
    }
  },
  "sideEffects": false,
  "packageManager": "npm@11.6.2",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "procurement",
    "japan",
    "government",
    "bids",
    "kkj",
    "cloud-run"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sugukurukabe/koko-call-mcp.git"
  },
  "homepage": "https://github.com/sugukurukabe/koko-call-mcp",
  "bugs": {
    "url": "https://github.com/sugukurukabe/koko-call-mcp/issues"
  },
  "bin": {
    "jp-bids-export": "dist/export-bids.js",
    "jp-bids-mcp": "dist/server.js",
    "jp-bids-slack-briefing": "dist/slack-briefing.js"
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "README.ja.md",
    "README.id.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "CITATION.cff",
    "server.json"
  ],
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "build": "npm run build:server && npm run typecheck:ui && npm run build:ui",
    "build:server": "tsc -p tsconfig.json && node --input-type=module -e \"import { chmodSync } from 'node:fs'; for (const f of ['dist/server.js','dist/slack-briefing.js','dist/export-bids.js']) chmodSync(f, 0o755);\"",
    "build:ui": "vite build && node --input-type=module -e \"process.env.VITE_APP='investor-radar'; const { build } = await import('vite'); await build();\"",
    "typecheck:ui": "tsc -p tsconfig.app.json",
    "typecheck:all": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.app.json && tsc -p tsconfig.test.json",
    "dev": "tsx src/server.ts",
    "dev:http": "tsx src/server.ts --http",
    "start": "node dist/server.js",
    "start:http": "node dist/server.js --http",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:safety": "node --test tests/acceptance/cdp-client.test.mjs tests/acceptance/ci-secret-command.test.mjs && node tests/acceptance/verify-net-guard.mjs && node tests/acceptance/verify-ci-secret-check.mjs && node --import ./tests/acceptance/net-guard.mjs tests/acceptance/gate1-runner.mjs && node --import ./tests/acceptance/net-guard.mjs cloudshell/run-f01-cleanup-probes.mjs && node --import ./tests/acceptance/net-guard.mjs cloudshell/run-offline-cloudshell-sim.mjs",
    "test:watch": "vitest",
    "test:contract": "vitest run tests/contract.test.ts",
    "bench": "tsx benchmarks/kkj.bench.ts",
    "mutation": "stryker run",
    "apps:harness": "tsx scripts/apps-harness/serve.ts",
    "apps:capture": "npm run build:ui && tsx scripts/apps-harness/capture.ts",
    "docs:api": "node scripts/generate-api-docs.mjs",
    "api:health": "tsx scripts/api-health-check.ts",
    "remote:health": "tsx scripts/remote-health-check.ts",
    "remote:mcp": "tsx scripts/remote-mcp-check.ts",
    "remote:extraction": "tsx scripts/remote-extraction-check.ts",
    "remote:domain": "tsx scripts/remote-domain-status.ts",
    "export:bids": "tsx src/export-bids.ts",
    "slack:briefing": "tsx scripts/slack-briefing.ts",
    "registry:validate": "tsx scripts/registry-validate.ts",
    "server-card:generate": "tsx scripts/generate-server-card.ts",
    "release:parity": "tsx scripts/release-parity-check.ts",
    "build:repro": "tsx scripts/reproducible-build.ts",
    "docs:check": "npm run docs:api && git diff --exit-code docs/api",
    "release:gate": "tsx scripts/release-gate.ts",
    "prepublishOnly": "npm run release:gate",
    "check": "npm run lint && npm run typecheck:all && npm run build && npm run test",
    "sbom": "cyclonedx-npm --output-file bom.json",
    "publish:dry-run": "npm run release:gate && npm publish --dry-run --access public --ignore-scripts",
    "security:dependencies": "node scripts/security-dependency-check.mjs",
    "security:code": "node scripts/run-code-security.mjs",
    "security:verify": "node --test tests/acceptance/code-security-review.test.mjs && node tests/acceptance/verify-security-dependency-check.mjs && node scripts/verify-code-security-canary.mjs"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.7.0",
    "@google/genai": "^1.51.0",
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.1",
    "lru-cache": "^11.3.5",
    "stripe": "^22.1.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@hono/node-server": "^2.1.8",
    "body-parser": "^2.4.0",
    "fast-uri": "^3.1.9",
    "google-gax": {
      "rimraf": "^6.1.4"
    },
    "hono": "^4.13.18",
    "ip-address": "^10.7.6",
    "qs": "^6.17.1",
    "form-data": "^4.0.6",
    "postcss": "^8.5.33",
    "nanoid@^3.0.0": "^3.3.20",
    "source-map-js": "^1.2.2",
    "esbuild@^0.28.0": "^0.28.2",
    "@babel/core": "^7.29.13",
    "browserslist": "^4.29.6",
    "baseline-browser-mapping": "^2.11.38",
    "brace-expansion@^5.0.0": "^5.0.13",
    "minimatch@^10.0.0": "^11.0.9",
    "markdown-it": "^14.3.3",
    "linkify-it": "^5.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@cyclonedx/cyclonedx-npm": "^7.0.1",
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.12",
    "ajv-formats-draft2019": "^1.6.1",
    "fast-check": "^4.7.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "supertest": "^7.2.2",
    "tinybench": "^6.0.1",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^4.1.12"
  }
}
