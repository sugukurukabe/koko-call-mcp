{
  "name": "@sugukuru-labs/public-mcp-jp-gateway",
  "version": "0.1.0",
  "description": "日本の公的データ・業務SaaS MCPサーバーを1回の接続で使えるFederation Gateway。JP Bids（入札）・Jグランツ（補助金）・法人番号・AgriOps・不動産インテル（地価・投資分析）・MoneyForwardクラウド会計・freeeを安全に束ねます。Japan public-data MCP Federation Gateway connecting JP Bids, J-Grants, Corporate Number, AgriOps, Real Estate Intel, MoneyForward Cloud Accounting, and freee through a single secure connection.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/mcp.js",
  "types": "./dist/mcp.d.ts",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "dev:http": "tsx src/server.ts --http",
    "start": "node dist/server.js",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:production": "tsx scripts/verify-production.ts",
    "check": "npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@hono/node-server": "^2.1.8",
    "body-parser": "^2.4.0",
    "fast-uri": "^3.1.9",
    "hono": "^4.13.18",
    "ip-address": "^10.7.6",
    "proxy-addr": "^2.0.8",
    "qs": "^6.17.1",
    "form-data": "^4.0.6",
    "postcss": "^8.5.33",
    "nanoid@^3.0.0": "^3.3.20",
    "source-map-js": "^1.2.2",
    "esbuild@^0.28.0": "^0.28.2",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
